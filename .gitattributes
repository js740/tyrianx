# Normalize all text files to LF in the repository
* text=auto

# Source code — always LF, even on Windows
*.c         text eol=lf
*.h         text eol=lf
*.cpp       text eol=lf
*.hpp       text eol=lf

# Build and config files — always LF
Makefile    text eol=lf
*.sh        text eol=lf
*.md        text eol=lf

# Windows project files — always CRLF
*.sln               text eol=crlf
*.vcxproj           text eol=crlf
*.props.template    text eol=crlf
*.rc                text eol=crlf
*.bat               text eol=crlf

# Binary files
*.png       binary
*.bmp       binary
